# Copie para .env e ajuste os valores. Nunca versione o .env.

# Conexão com o PostgreSQL
DATABASE_URL=postgres://usuario:senha@host:5432/banco
PORT=3001

# Senha de acesso ao dashboard (obrigatória: a API não sobe sem ela)
APP_PASSWORD=troque-esta-senha
# Segredo para assinar o token de sessão: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Somente em produção: domínios do front autorizados, separados por vírgula
# CORS_ORIGIN=https://seu-projeto.vercel.app
